# Copy to .env and fill in. NEVER commit .env.

# From @BotFather (the same bot the PassVault app is connected to)
BOT_TOKEN=

# Leave empty on the first run: the bot replies with your chat ID. Paste it here and restart.
OWNER_CHAT_ID=

TIMEZONE=Asia/Kolkata

# Weekly "your backup is old" check
WEEKLY_REMINDER_DAY=sun
WEEKLY_REMINDER_TIME=21:00
STALE_AFTER_DAYS=7

# Monthly "do you remember your master password?" (day of month, 10:00)
MONTHLY_REMINDER_DAY=1

DB_FILE=passvault_bot.sqlite3
